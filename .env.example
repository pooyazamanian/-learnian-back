# Application Configuration
APP_NAME="Lurnian Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# Logging Configuration
LOG_LEVEL="INFO"

# Authentication Configuration
# Override JWT_SECRET outside development; keep it out of version control.
JWT_SECRET="dev-only-change-me"
JWT_ISSUER="lurnian"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=365
SESSION_ABSOLUTE_TTL_DAYS=365

# Phone sign-in (OTP)
DEFAULT_PHONE_COUNTRY_CODE=98
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_NUMBER_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
# Generate a real pepper outside development and keep it out of version control.
OTP_PEPPER="dev-only-otp-pepper"
# Local development only: echo the generated code in the API response.
OTP_EXPOSE_IN_RESPONSE=false

# Database Configuration
DATABASE_URL="postgresql+psycopg://lurnian:lurnian@127.0.0.1:5432/lurnian"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_READY_TIMEOUT=2

# Local PostgreSQL (docker compose)
POSTGRES_USER="lurnian"
POSTGRES_PASSWORD="lurnian"
POSTGRES_DB="lurnian"

# Local Redis (docker compose): reserved for rate limiting, caching and queues
REDIS_PASSWORD="lurnian"
# REDIS_URL="redis://:lurnian@127.0.0.1:6379/0"

# Local object storage (docker compose): avatars and audio live behind
# `*_object_key` columns, so an S3 endpoint is part of the run environment.
# SeaweedFS serves the S3 API on 8333 without credentials (development only).
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="lurnian"

# Local mail catcher (docker compose): SMTP on 2525, UI on http://127.0.0.1:8026
# SMTP_HOST="127.0.0.1"
# SMTP_PORT=2525
